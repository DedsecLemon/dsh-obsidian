{
  "name": "dsh-obsidian-panel",
  "version": "1.2.0",
  "private": true,
  "description": "把 Obsidian 知识库放进 DSH 右侧栏：目录树、全文搜索、Obsidian 排版风格的笔记页、笔记大纲，对话则交给应用自己的对话面板在中间打开 / An Obsidian vault in the DSH right Sidebar: vault tree, full-vault search, Obsidian-styled note pages, a note outline, and the vault conversation opened in the app's own centre panel.",
  "type": "module",
  "main": "./index.mjs",
  "exports": {
    ".": "./index.mjs",
    "./client": {
      "default": "./client.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "index.mjs",
    "client.js",
    "cordis.patch.yml",
    "README.md",
    "README.zh-CN.md",
    "INSTALL.md",
    "INSTALL.zh-CN.md"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/DedsecLemon/dsh-obsidian.git"
  },
  "homepage": "https://github.com/DedsecLemon/dsh-obsidian#readme",
  "bugs": {
    "url": "https://github.com/DedsecLemon/dsh-obsidian/issues"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web"
    },
    "compatibility": {
      "dsh": "^0.2.0-rc.2",
      "dshReleases": {
        "0.1.7-rc.2": "unknown",
        "0.2.0-rc.1": "unknown",
        "0.2.0-rc.2": "compatible"
      },
      "dshOperations": {
        "0.2.0-rc.2": {
          "install": "passed",
          "start": "passed",
          "uninstall": "passed",
          "rollback": "unknown"
        }
      },
      "node": ">=22.12.0",
      "profiles": [
        "web"
      ]
    }
  },
  "engines": {
    "node": ">=22.12.0"
  },
  "os": [
    "win32",
    "darwin",
    "linux"
  ],
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "obsidian",
    "obsidian-vault",
    "cordis"
  ],
  "license": "MIT",
  "devDependencies": {
    "jsdom": "^30.1.1",
    "react": "^18.2.0",
    "react-dom": "^18.2.0"
  }
}
