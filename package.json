{
  "name": "dsh-obsidian",
  "version": "1.0.0",
  "private": true,
  "description": "把 Obsidian 知识库放进 DSH 右侧栏：目录树、全文搜索、Obsidian 排版风格的笔记页、可拖拽高度的对话框 / Obsidian vault in the DSH right sidebar: vault tree, full-vault search, Obsidian-styled note pages, and a resizable conversation box.",
  "type": "module",
  "main": "./index.mjs",
  "exports": {
    ".": "./index.mjs",
    "./client": {
      "default": "./client.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "index.mjs",
    "client.js",
    "cordis.patch.yml",
    "README.md",
    "INSTALL.md"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/DedsecLemon/dsh-obsidian.git"
  },
  "homepage": "https://github.com/DedsecLemon/dsh-obsidian#readme",
  "bugs": {
    "url": "https://github.com/DedsecLemon/dsh-obsidian/issues"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web"
    }
  },
  "keywords": [
    "dsh",
    "dsh-plugin",
    "obsidian"
  ],
  "license": "MIT",
  "devDependencies": {
    "jsdom": "^30.1.1",
    "react": "^18.2.0",
    "react-dom": "^18.2.0"
  }
}
