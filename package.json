{
  "name": "dsh-obsidian",
  "version": "1.0.0",
  "private": true,
  "description": "Obsidian vault in the DSH right Sidebar: vault tree, full-vault search, Obsidian-styled note pages with [[wikilink]] navigation and in-place editing, and a resizable conversation box served by a Session in the vault's own Workspace.",
  "type": "module",
  "main": "./index.mjs",
  "exports": {
    ".": "./index.mjs",
    "./client": {
      "default": "./client.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "index.mjs",
    "client.js",
    "cordis.patch.yml",
    "README.md",
    "INSTALL.md"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web"
    }
  },
  "keywords": [
    "dsh",
    "dsh-plugin",
    "obsidian"
  ],
  "license": "MIT",
  "devDependencies": {
    "jsdom": "^30.1.1",
    "react": "^18.2.0",
    "react-dom": "^18.2.0"
  }
}
